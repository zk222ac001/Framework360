# Local Docker development environment.
# Copy this file to .env and replace placeholders with your own test values.

# Stripe test-mode values. Price IDs must start with price_, not prod_.
STRIPE_SECRET_KEY=sk_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STARTER_PRICE_ID=price_replace_me_starter
STRIPE_PROFESSIONAL_PRICE_ID=price_replace_me_professional
STRIPE_ENTERPRISE_PRICE_ID=price_replace_me_enterprise

# Local development keeps uploaded evidence files on disk.
STORAGE_DRIVER=local

# Optional transactional email for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Framework360 <no-reply@example.com>
