NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://framework360:change-me-in-production@postgres:5432/framework360?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=https://app.your-domain.example
APP_BASE_URL=https://app.your-domain.example
VITE_API_BASE_URL=https://api.your-domain.example
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=framework360
POSTGRES_USER=framework360
POSTGRES_PASSWORD=change-me-in-production

# Production evidence storage. Use any S3-compatible provider, e.g. Cloudflare R2,
# AWS S3, Supabase Storage S3 compatibility, or another managed object store.
STORAGE_DRIVER=s3
S3_BUCKET=framework360-evidence
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=evidence

# Use this only for private beta/local production-style demos without object storage.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true

# Transactional email. Resend SMTP works with host smtp.resend.com, port 587,
# user resend, password your Resend API key, and MAIL_FROM from a verified domain.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=re_replace_me
MAIL_FROM=Framework360 <no-reply@your-domain.example>

STRIPE_SECRET_KEY=sk_live_or_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
STRIPE_PROFESSIONAL_PRICE_ID=price_your_professional_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id
